# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
build/
dist/

# Env
.env

# Test / lint
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ML tracking (Phase 2+; SQLite backend + local artifact store, see mlflow_config.py)
mlruns/
mlflow.db

# Imputation-selector artifacts are regenerated fresh on every pipeline run
# from companies.csv (itself not committed) — not durable trained models
# like the column-type classifier, so not worth version-controlling.
src/lucidflow/models/imputation_selector/*.joblib

# Auto-generated Pydantic contracts (contract_generation) are regenerated
# fresh from whatever CSV is pointed at them, and can embed real observed
# values from uncommitted source data (e.g. companies.csv) as comments — not
# durable artifacts, same reasoning as the imputation selector above.
src/lucidflow/contract_generation/generated/

# Contains verbatim rows (names, descriptions, addresses) from companies.csv,
# which itself isn't committed — regenerate via build_dataset.py.
src/lucidflow/models/quarantine_classifier/labeled_dataset.json

# Data (large datasets — not committed; provide your own under data/intake/)
data/**
!data/**/
!data/**/.gitkeep
!data/intake/demo_dirty_sample.csv

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
