# MinIO -- S3-compatible MLflow artifact store, only used inside the Docker Compose
# stack (see docker-compose.yml's app service and src/lucidflow/mlflow_config.py).
# Not used by local (non-Docker) runs.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
